# Adapter boutique.example.fr puis installer dans /etc/nginx/sites-available/lpada
# Activer le certificat HTTPS avec Certbot AVANT de servir des clients réels.
# Ce fichier ne configure que HTTP pour obtenir le certificat initial.
server {
    listen 80;
    server_name boutique.example.fr;
    root /var/www/lpada/current;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
